<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controleurs.PromotionController" prefHeight="600.0" prefWidth="800.0">
    <children>
        <fx:include fx:id="navBar" source="NavBar.fxml" />

        <VBox spacing="15" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Liste de la Promotion" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchFD" promptText="Rechercher un étudiant" prefWidth="250"/>
                <Label fx:id="lblCompteur" text="Total : 0 étudiants" style="-fx-font-style: italic;"/>
            </HBox>

            <TableView fx:id="tablePromotion" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNom" text="Nom" prefWidth="120"/>
                    <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="120"/>
                    <TableColumn fx:id="colGenre" text="Genre" prefWidth="80"/>
                    <TableColumn fx:id="colBac" text="Bac" prefWidth="100"/>
                    <TableColumn fx:id="colGroupe" text="Affectations (TD / TP)" prefWidth="200"/>
                    <TableColumn fx:id="colMail" text="Mail Professionnel" prefWidth="200"/>
                </columns>
            </TableView>
        </VBox>
    </children>
</VBox>