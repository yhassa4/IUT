<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?> <?import javafx.scene.image.Image?>     <BorderPane fx:id="mainContainer" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controleurs.MainController">
    <top>
        <HBox style="-fx-background-color: #0c0d16; -fx-padding: 20 30;" alignment="CENTER_LEFT">
            
            <ImageView fitHeight="50.0" preserveRatio="true">
                <image>
                    <Image url="@../image/logo_paris_saclay.png"/>
                </image>
            </ImageView>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <HBox spacing="15" alignment="CENTER">
					<Label fx:id="userRoleLabel" text="Connecté en tant que : Enseignant" textFill="#cccccc" 
					       style="-fx-font-size: 13px; 
					              -fx-font-style: italic; 
					              -fx-border-color: #a50044; 
					              -fx-border-width: 0 0 0 3; 
					              -fx-padding: 0 0 0 10;">
					</Label>
                <Button fx:id="logoutButton" 
                        text="Déconnexion" 
                        onAction="#handleLogout" 
                        style="-fx-background-color: #a50044; -fx-text-fill: white; -fx-cursor: hand;" />
           </HBox>
        </HBox>
    </top>

    <center>
        </center>

    <bottom>
        <HBox style="-fx-background-color: #0c0d16; -fx-padding: 10;">
            <Label text="SAE S3 - Gestion des Groupes" textFill="WHITE" />
        </HBox>
    </bottom>
</BorderPane>