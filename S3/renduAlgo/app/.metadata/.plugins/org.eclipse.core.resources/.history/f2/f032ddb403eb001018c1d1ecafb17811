     */
    public ArrayList<String> getToutesLesMatieres() {
    	ArrayList<String> r = new ArrayList<String>();
    	for(Matiere m :matiereEnsei) {
    		r.add(m.getNomMatiere());
    	}
    	
    	
        return r;
    }

