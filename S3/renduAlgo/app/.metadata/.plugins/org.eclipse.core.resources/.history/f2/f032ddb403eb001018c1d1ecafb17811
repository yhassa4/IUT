		return this.prenomEnsei;
	}
	public ArrayList<Matiere> getMatiereEnsei(){
		return matiereEnsei;
	}
	public void addMatiere(Matiere m) {
		if(!matiereEnsei.contains(m)) {
			matiereEnsei.add(m);
		}
	}
	public void ajouterCours(Matiere m, GroupTD td, GroupTP tp) {
	    this.mesCours.add(new AffectationEnseignant(m, td, tp));
	}
	public String getMatierePourGroupe(IGroup groupeSelectionne) {
        if (groupeSelectionne == null) return "";
        String retour = "" ;
        
        for (AffectationEnseignant aff : mesCours) {
            if (groupeSelectionne instanceof GroupTD && aff.getGroupeTD() != null) {
                if (aff.getGroupeTD().equals(groupeSelectionne)) {
                	retour += aff.getMatiere().getNomMatiere() + " , ";
                }
            }
            // Vérification si c'est le bon TP
            if (groupeSelectionne instanceof GroupTP && aff.getGroupeTP() != null) {
                if (aff.getGroupeTP().equals(groupeSelectionne)) {
                	retour += aff.getMatiere().getNomMatiere() + " , ";
                }
            }
        }
        return retour;
    }

    /**
