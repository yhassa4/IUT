        this.prenomEnsei = prenomEnsei;
        this.setGenreEnsei(genreEnsei);
        this.mailProEnsei = mailProEnsei;
        this.mailPersoEnsei = mailPersoEnsei;
        this.addrEnsei = addrEnsei;
   
