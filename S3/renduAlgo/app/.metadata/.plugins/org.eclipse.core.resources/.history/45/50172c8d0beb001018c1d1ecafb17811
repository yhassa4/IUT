<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" style="-fx-background-color: #f4f4f9;"
	xmlns:fx="http://javafx.com/fxml"
	fx:controller="controleurs.GestionEnseignantController">

	<fx:include fx:id="navBar" source="NavBar.fxml" />

	<VBox VBox.vgrow="ALWAYS"
		style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);">

		<Label text="Annuaire des Enseignants"
			style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0c0d16;">
			<VBox.margin>
				<Insets bottom="15" />
			</VBox.margin>
		</Label>
		<HBox spacing="10" alignment="CENTER_LEFT">
			<Button text="Ajouter Enseignant"
				onAction="#handleAjouterEnseignant"
				style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />

			<Button text="Modifier le Rôle" onAction="#handleModifierRole"
				style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />

			<Region HBox.hgrow="ALWAYS" />

			<Button text="Supprimer" onAction="#handleSupprimerEnseignant"
				style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
		</HBox>


		<TableView fx:id="tableEnseignants" VBox.vgrow="ALWAYS"
			style="-fx-background-radius: 5;">
			<columns>
				<TableColumn fx:id="colNom" text="Nom" prefWidth="120" />
				<TableColumn fx:id="colPrenom" text="Prénom"
					prefWidth="120" />
				<TableColumn fx:id="colGenre" text="Genre"
					prefWidth="80" />
				<TableColumn fx:id="colMatiere" text="Matière(s)"
					prefWidth="250" />
				<TableColumn fx:id="colRole" text="Rôle" prefWidth="150" />
			</columns>
			<columnResizePolicy>
				<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
			</columnResizePolicy>
		</TableView>
	</VBox>
</VBox>