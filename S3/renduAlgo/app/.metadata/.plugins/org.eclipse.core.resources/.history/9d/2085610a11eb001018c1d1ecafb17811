        if(!cUser.getRole().equals("RESPONSABLE DE FILIÈRE") && !cUser.getRole().equals("RESPONSABLE DE FORMATION")) {
        	buttonImport.setVisible(false);
        	buttonExport.setVisible(false);
        }
        
        
        navBarController.updateNav(1);
        
