    @FXML
    private void handleLogin() {

        String user = loginField.getText();
        String pass = passwordField.getText();


        MainController mainCtrl = Appli.main.getMainController();

        // ============================
        //   1) Connexion Étudiant
        // ============================
        try {
        	user = "claire.moreau@univ.fr";
        	
            for (int i = 0 ;i < Etudiant.ListEtu.length()-1;i++) {
            	Etudiant e = Etudiant.ListEtu.get(i);
            	System.out.println(e.getmailpro() +"  "+ e.getPassword());
            	System.out.println(user +"  "+ pass);
                if (e.getmailpro().equals(user) &&e.getPassword().equals(pass)) {
                    main.setCurrentUser(e);
                    mainCtrl.setRole(e.getRole());
                    mainCtrl.chargerPage("VueinfoEtudiant.fxml");
                    mainCtrl.setLogoutButtonVisible(true);
                    System.out.println("Connexion Étudiant : " + e.getNomComplet());
                    System.out.println("INT");
                    return;
                }
            }

            // ============================
            //   2) Connexion Enseignant
            // ============================
            for (Enseignant ens : Enseignant.ListEnseignant) {
                if (ens.getMailProEnsei().equals(user) && ens.getPassword().equals(pass)){
                    main.setCurrentUser(ens);

                    // Page selon rôle
                    switch (ens.getRole()) {
                        case "RESPONSABLE DE FORMATION":
                        case "RESPONSABLE DE FILIÈRE":
                        case "RESPONSABLE SEMESTRE":
                        case "RESPONSABLE D’ANNÉE":
                            mainCtrl.setRole(ens.getRole());
                            mainCtrl.chargerPage("VueEnsembleResponsable.fxml");
                            break;

                        default:
                            mainCtrl.setRole("ENSEIGNANT");
                            mainCtrl.chargerPage("VueEnsembleEnseignant.fxml");
                            break;
                    }

                    mainCtrl.setLogoutButtonVisible(true);
                    System.out.println("Connexion Enseignant : " + ens.getNomComplet());
                    return;
                }
            }

        } catch (NumberFormatException e) {
            errorLabel.setText("Identifiant invalide");
            return;
        }

        errorLabel.setText("Identifiants incorrects");
    }



